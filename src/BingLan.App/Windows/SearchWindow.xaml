<Window x:Class="BingLan.App.Windows.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="冰蓝搜索" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" AllowsTransparency="True"
        Background="Transparent" Height="48" MinWidth="240" MaxWidth="800">
    <Border Background="#F01E1F24" BorderBrush="#6693C5FD" BorderThickness="1" CornerRadius="10">
        <Grid Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
            </Grid.ColumnDefinitions>
            <Thumb x:Name="MoveHandle" Focusable="False" Cursor="SizeAll" ToolTip="拖动搜索框"
                   AutomationProperties.Name="拖动搜索框">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"><TextBlock Text="⠿" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <ContentPresenter x:Name="SearchContent" Grid.Column="1" VerticalAlignment="Center"/>
            <Thumb x:Name="WidthHandle" Grid.Column="2" Focusable="False" Cursor="SizeWE" ToolTip="调整搜索框宽度"
                   AutomationProperties.Name="调整搜索框宽度">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"><TextBlock Text="⋮" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
