<Window x:Class="BingLan.App.Windows.IceBlueDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="冰蓝 Dock"
        Width="180"
        Height="104"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        AllowDrop="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="DockItemButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <!-- No tile behind the icon: its square would not match the icon's own
                             shape. Hover zooms the icon; a press dims it. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="DockSurface"
            Padding="14,5"
            Background="{DynamicResource DockSurfaceBrush}"
            BorderBrush="{DynamicResource DockSurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            AllowDrop="True"
            MouseRightButtonUp="OnDockSurfaceRightClick">
        <ScrollViewer x:Name="ItemScroller"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ItemPanel" Orientation="Horizontal"/>
        </ScrollViewer>
    </Border>
</Window>
